<Window x:Class="TechInventory.Views.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление пользователями"
        Height="420" Width="750"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Добавить" Click="AddUser_Click" Width="110" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="✎ Редактировать" Click="EditUser_Click" Width="130" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="✕ Удалить" Click="DeleteUser_Click" Width="90" Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>
        </Border>

        <ListView Grid.Row="1" ItemsSource="{Binding Users}" x:Name="UsersListView" Style="{StaticResource ListViewStyle}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding UserID}" Width="50"/>
                    <GridViewColumn Header="Логин" DisplayMemberBinding="{Binding Login}" Width="130"/>
                    <GridViewColumn Header="ФИО" DisplayMemberBinding="{Binding FullName}" Width="220"/>
                    <GridViewColumn Header="Роль" DisplayMemberBinding="{Binding Role}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>