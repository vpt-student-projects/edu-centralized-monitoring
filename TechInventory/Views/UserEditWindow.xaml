<Window x:Class="TechInventory.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование пользователя"
        Height="370" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Margin="16" Background="White" CornerRadius="12" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,4">
                <TextBlock Text="Логин:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="LoginBox" Style="{StaticResource TextBoxStyle}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,4">
                <TextBlock Text="Пароль:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxStyle}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,4">
                <TextBlock Text="ФИО:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="FullNameBox" Style="{StaticResource TextBoxStyle}"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,4">
                <TextBlock Text="Роль:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="RoleCombo" Style="{StaticResource ComboBoxStyle}">
                    <ComboBoxItem Content="Admin" Tag="Admin"/>
                    <ComboBoxItem Content="Teacher" Tag="Teacher" IsSelected="True"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,12,0,0">
                <Button Content="Сохранить" Click="SaveButton_Click" Width="90" Margin="0,0,10,0"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Отмена" Click="CancelButton_Click" Width="80"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>