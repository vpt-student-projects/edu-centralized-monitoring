<Window x:Class="TechInventory.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему"
        Height="460" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Viewbox Grid.Row="0" Height="40" Margin="0,0,0,20">
                <TextBlock Text="IT-Инфраструктура" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextAlignment="Center"/>
            </Viewbox>

            <TextBox Grid.Row="1" x:Name="LoginTextBox" 
                     Margin="0,8" Style="{StaticResource TextBoxStyle}"
                     ToolTip="Введите логин"/>

            <PasswordBox Grid.Row="2" x:Name="PasswordBox" 
                         Margin="0,8" Style="{StaticResource PasswordBoxStyle}"
                         ToolTip="Введите пароль"/>

            <Button Grid.Row="3" Content="Войти" Click="LoginButton_Click"
                    Height="40" Margin="0,12,0,0" Style="{StaticResource AccentButtonStyle}"/>

            <Button Grid.Row="4" Content="Регистрация" Click="RegisterButton_Click"
                    Height="34" Margin="0,8,0,0" Style="{StaticResource SecondaryButtonStyle}"/>

            <TextBlock Grid.Row="5" x:Name="ErrorTextBlock" Foreground="{StaticResource DangerBrush}" 
                       TextWrapping="Wrap" Margin="0,10,0,0" TextAlignment="Center"/>
        </Grid>
    </Border>
</Window>