<Window x:Class="TechInventory.Views.MoveDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переместить устройство"
        Height="350" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Margin="16" Background="White" CornerRadius="12" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="CurrentRoomText" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Новый кабинет:" Width="120" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <ComboBox x:Name="RoomComboBox" DisplayMemberPath="Name" SelectedValuePath="RoomID"
                          SelectedValue="{Binding SelectedRoomId}" Width="200" Style="{StaticResource ComboBoxStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6">
                <TextBlock Text="Новая позиция:" Width="120" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBox x:Name="PositionTextBox" Text="{Binding NewPosition, UpdateSourceTrigger=PropertyChanged}" 
                         Width="60" Style="{StaticResource TextBoxStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,6">
                <TextBlock Text="Причина (необязательно):" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="ReasonTextBox" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" 
                         TextWrapping="Wrap" Height="60" Style="{StaticResource TextBoxStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Переместить" Click="MoveButton_Click" Width="110" Margin="0,0,10,0"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Отмена" Click="CancelButton_Click" Width="80"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>