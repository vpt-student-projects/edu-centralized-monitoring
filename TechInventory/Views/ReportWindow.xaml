<Window x:Class="TechInventory.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Формирование отчёта"
        Height="260" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Margin="16" Background="White" CornerRadius="12" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Выберите тип отчёта:" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

            <StackPanel Grid.Row="1">
                <RadioButton x:Name="PurchaseRadio" Content="Для закупки (сломанное оборудование)" Margin="0,4" IsChecked="True"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
                <RadioButton x:Name="InventoryRadio" Content="Инвентаризационный (все устройства)" Margin="0,4"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
                <RadioButton x:Name="TicketsRadio" Content="Статистика по заявкам" Margin="0,4"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Сформировать" Click="GenerateButton_Click" Width="120" Margin="0,0,10,0"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Отмена" Click="CancelButton_Click" Width="80"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>