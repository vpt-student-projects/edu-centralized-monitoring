<Window x:Class="TechInventory.Views.DeviceCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TechInventory.ViewModels"
        Title="Карточка устройства"
        Height="500" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding Device.Name}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Тип: " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold"/>
                    <TextBlock Text="  |  Статус: " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding StatusName}" Foreground="{Binding StatusName, Converter={StaticResource StatusToColorConverter}}" FontWeight="SemiBold"/>
                    <TextBlock Text="  |  Закреплён: " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AssignedUserName}" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding Device.Specs}" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" 
                            Visibility="{Binding CanAssign, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Ответственный:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding AvailableUsers}" SelectedValue="{Binding SelectedUserId}"
                              DisplayMemberPath="FullName" SelectedValuePath="UserID" Width="160"
                              Style="{StaticResource ComboBoxStyle}"/>
                    <Button Content="Назначить" Command="{Binding AssignUserCommand}" Width="90" Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Перемещения" Style="{StaticResource TabItemStyle}">
                <ListView ItemsSource="{Binding Movements}" Style="{StaticResource ListViewStyle}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding MoveDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="150"/>
                            <GridViewColumn Header="Из кабинета" DisplayMemberBinding="{Binding FromRoom}" Width="100"/>
                            <GridViewColumn Header="В кабинет" DisplayMemberBinding="{Binding ToRoom}" Width="100"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Заявки" Style="{StaticResource TabItemStyle}">
                <ListView ItemsSource="{Binding Tickets}" Style="{StaticResource ListViewStyle}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Description}" Width="200"/>
                            <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="90"/>
                            <GridViewColumn Header="Приоритет" DisplayMemberBinding="{Binding Priority}" Width="80"/>
                            <GridViewColumn Header="Кабинет" DisplayMemberBinding="{Binding RoomName}" Width="80"/>
                            <GridViewColumn Header="Создана" DisplayMemberBinding="{Binding CreatedAt}" Width="130"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Переместить" Command="{Binding MoveDeviceCommand}" Width="110" Margin="0,0,8,0"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="Создать заявку" Command="{Binding CreateTicketCommand}" Width="130" Margin="0,0,8,0"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="Закрыть" Click="CloseButton_Click" Width="90"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>