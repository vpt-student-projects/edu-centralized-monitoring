<Window x:Class="TechInventory.Views.SelectDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выберите устройство"
        Height="170" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Margin="16" Background="White" CornerRadius="12" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Устройство:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <ComboBox Grid.Row="0" x:Name="DeviceComboBox" DisplayMemberPath="Name" SelectedValuePath="DeviceID"
                      Style="{StaticResource ComboBoxStyle}" Margin="0,0,0,12"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Далее" Click="OkButton_Click" Width="80" Margin="0,0,10,0"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Отмена" Click="CancelButton_Click" Width="80"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>