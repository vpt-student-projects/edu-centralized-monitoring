<Window x:Class="TechInventory.Views.RoomsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление кабинетами"
        Height="420" Width="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Добавить" Click="Add_Click" Width="110" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="✎ Изменить" Click="Edit_Click" Width="110" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="✕ Удалить" Click="Delete_Click" Width="90" Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>
        </Border>

        <ListView Grid.Row="1" ItemsSource="{Binding Rooms}" x:Name="RoomsListView" Style="{StaticResource ListViewStyle}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="100"/>
                    <GridViewColumn Header="Этаж" DisplayMemberBinding="{Binding Floor}" Width="70"/>
                    <GridViewColumn Header="Корпус" DisplayMemberBinding="{Binding Building}" Width="100"/>
                    <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Description}" Width="220"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>