<Window x:Class="TechInventory.Views.TicketsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TechInventory.ViewModels"
        Title="Лента заявок"
        Height="580" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#106EBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <TextBlock Grid.Row="0" Text="📋  Лента заявок" FontSize="20" FontWeight="SemiBold"
                   Foreground="#111827" Margin="0,0,0,14"/>

        <!-- Filters card -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,12"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="#000"/>
            </Border.Effect>
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Приоритет:" VerticalAlignment="Center" FontSize="13" Foreground="#6B7280" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriority}"
                              Width="110" Style="{StaticResource FilterCombo}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Статус:" VerticalAlignment="Center" FontSize="13" Foreground="#6B7280" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                              Width="110" Style="{StaticResource FilterCombo}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Кабинет:" VerticalAlignment="Center" FontSize="13" Foreground="#6B7280" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding RoomOptions}" SelectedValue="{Binding SelectedRoomId}"
                              DisplayMemberPath="DisplayName" SelectedValuePath="RoomID"
                              Width="110" Style="{StaticResource FilterCombo}"/>
                </StackPanel>
                <CheckBox IsChecked="{Binding OnlyMyDevices}" Content="Только мои устройства"
                          Visibility="{Binding IsTeacher, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                          Foreground="#374151" Margin="0,0,16,0"/>
                <Button Content="🔄  Обновить" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecButton}" Width="120" Margin="0,0,8,0"/>
                <Button Content="✔  Закрыть заявку" Command="{Binding CloseTicketCommand}"
                        Style="{StaticResource ActionButton}" Width="150"/>
            </WrapPanel>
        </Border>

        <!-- Tickets table card -->
        <Border Grid.Row="2" Background="White" CornerRadius="10"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="#000"/>
            </Border.Effect>
            <ListView ItemsSource="{Binding Tickets}" SelectedItem="{Binding SelectedTicket}"
                      BorderThickness="0" AlternationCount="2" FontFamily="Segoe UI" FontSize="13">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4,6"/>
                        <Setter Property="Foreground" Value="#1A1A1A"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Устройство" DisplayMemberBinding="{Binding DeviceName}" Width="120"/>
                        <GridViewColumn Header="Кабинет" DisplayMemberBinding="{Binding RoomName}" Width="80"/>
                        <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Description}" Width="220"/>
                        <GridViewColumn Header="Приоритет" DisplayMemberBinding="{Binding Priority}" Width="80"/>
                        <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="90"/>
                        <GridViewColumn Header="Создана" DisplayMemberBinding="{Binding CreatedAt}" Width="130"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Window>
