<Window x:Class="TechInventory.Views.RoomsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление кабинетами"
        Height="400" Width="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Button Content="+ Добавить" Click="Add_Click" Width="100" Margin="0,0,10,0"/>
            <Button Content="✎ Изменить" Click="Edit_Click" Width="100" Margin="0,0,10,0"/>
            <Button Content="✕ Удалить" Click="Delete_Click" Width="80" Background="LightCoral"/>
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Rooms}" x:Name="RoomsListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="80"/>
                    <GridViewColumn Header="Этаж" DisplayMemberBinding="{Binding Floor}" Width="60"/>
                    <GridViewColumn Header="Корпус" DisplayMemberBinding="{Binding Building}" Width="80"/>
                    <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Description}" Width="200"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>